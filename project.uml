@startuml
start

:Инициализация флагов и переменных;
:Парсинг аргументов командной строки;

if (Режим потоковой обработки?) then (Да)
  :Чтение провайдера и модели из аргументов;
  :Вызов ProcessStreamingLLM();
  stop
else (Нет)
endif

if (Передан путь к GitHub?) then (Да)
  :Загрузка проекта через loadGitHubProject();
  :Запуск редактора;
  stop
else (Нет)
endif

if (Запрос версии?) then (Да)
  :Вывод версии редактора;
  stop
else (Нет)
endif

if (Путь - директория?) then (Да)
  :Создание редактора с проектом (NewEditorWithProject);
  :Чтение файлов проекта через readProjectFiles();
  :Формирование обзора проекта через createProjectOverview();
  :Создание канвасов для каждого файла проекта;
else (Нет - файл)
  :Создание базового редактора (NewEditor);
  :Загрузка файла если существует;
  :Определение языка через detectLanguage();
endif

:Инициализация параметров редактора;
:Запуск основного цикла редактора;

@enduml